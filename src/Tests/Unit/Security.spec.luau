--!strict
local ServerScriptService = game:GetService("ServerScriptService")
local CooldownTracker = require(ServerScriptService.Server.Core.CooldownTracker)
local RateLimiter = require(ServerScriptService.Server.Core.RateLimiter)
local Validate = require(ServerScriptService.Server.Core.Validate)

return function(t: any)
	t.describe("Validate", function()
		t.it("rejects NaN, infinities, and wrong types", function()
			t.expect(Validate.isFiniteNumber(1)).toBe(true)
			t.expect(Validate.isFiniteNumber(0 / 0)).toBe(false)
			t.expect(Validate.isFiniteNumber(math.huge)).toBe(false)
			t.expect(Validate.isFiniteNumber(-math.huge)).toBe(false)
			t.expect(Validate.isFiniteNumber("1")).toBe(false)
		end)

		t.it("validates Vector3 payloads", function()
			t.expect(Validate.isFiniteVector3(Vector3.new(1, 2, 3))).toBe(true)
			t.expect(Validate.isFiniteVector3(Vector3.new(0 / 0, 0, 0))).toBe(false)
			t.expect(Validate.isFiniteVector3(Vector3.new(math.huge, 0, 0))).toBe(false)
			t.expect(Validate.isFiniteVector3(Vector3.new(1e9, 0, 0))).toBe(false)
			t.expect(Validate.isFiniteVector3({ X = 1, Y = 2, Z = 3 })).toBe(false)
			t.expect(Validate.isDirection(Vector3.zero)).toBe(false)
		end)

		t.it("validates strings, enums, integers, and plain tables", function()
			t.expect(Validate.isShortString("Join")).toBe(true)
			t.expect(Validate.isShortString("")).toBe(false)
			t.expect(Validate.isShortString(string.rep("x", 65))).toBe(false)
			t.expect(Validate.isOneOf("Join", { Join = "Join" })).toBe(true)
			t.expect(Validate.isOneOf("Hack", { Join = "Join" })).toBe(false)
			t.expect(Validate.isInteger(3, 0, 5)).toBe(true)
			t.expect(Validate.isInteger(3.5, 0, 5)).toBe(false)
			t.expect(Validate.isPlainTable({ SfxVolume = 1 }, { SfxVolume = true }, 4)).toBe(true)
			t.expect(Validate.isPlainTable({ Evil = 1 }, { SfxVolume = true }, 4)).toBe(false)
			t.expect(Validate.isPlainTable({ 1, 2 }, { SfxVolume = true }, 4)).toBe(false)
			t.expect(Validate.isPlainTable(setmetatable({}, {}), {}, 4)).toBe(false)
			t.expect(Validate.argCount(1, "a")).toBe(true)
			t.expect(Validate.argCount(1, "a", "b")).toBe(false)
		end)
	end)

	t.describe("RateLimiter", function()
		t.it("allows a burst up to capacity then refills over time", function()
			local limiter = RateLimiter.new({ Ability = { capacity = 3, refillPerSecond = 1 } })
			t.expect(limiter:allow(1, "Ability", 0)).toBe(true)
			t.expect(limiter:allow(1, "Ability", 0)).toBe(true)
			t.expect(limiter:allow(1, "Ability", 0)).toBe(true)
			t.expect(limiter:allow(1, "Ability", 0)).toBe(false)
			t.expect(limiter:allow(1, "Ability", 1)).toBe(true)
			t.expect(limiter:allow(1, "Ability", 1)).toBe(false)
		end)

		t.it("tracks players and actions independently and forgets departed players", function()
			local limiter = RateLimiter.new({ A = { capacity = 1, refillPerSecond = 0 } })
			t.expect(limiter:allow(1, "A", 0)).toBe(true)
			t.expect(limiter:allow(1, "A", 0)).toBe(false)
			t.expect(limiter:allow(2, "A", 0)).toBe(true)
			t.expect(limiter:allow(1, "B", 0)).toBe(true) -- default rule
			limiter:removePlayer(1)
			t.expect(limiter:bucketCount()).toBe(1)
		end)
	end)

	t.describe("CooldownTracker", function()
		t.it("is authoritative on server time", function()
			local c = CooldownTracker.new()
			t.expect(c:isReady("1:TimeFreeze", 0)).toBe(true)
			t.expect(c:start("1:TimeFreeze", 10, 22)).toBe(32)
			t.expect(c:isReady("1:TimeFreeze", 31.9)).toBe(false)
			t.expect(c:remaining("1:TimeFreeze", 30)).toBeNear(2, 1e-6)
			t.expect(c:isReady("1:TimeFreeze", 32)).toBe(true)
		end)

		t.it("clears by prefix between matches", function()
			local c = CooldownTracker.new()
			c:start("1:A", 0, 10)
			c:start("1:B", 0, 10)
			c:start("2:A", 0, 10)
			c:clearPrefix("1:")
			t.expect(c:isReady("1:A", 0)).toBe(true)
			t.expect(c:isReady("2:A", 0)).toBe(false)
			c:clear()
			t.expect(c:isReady("2:A", 0)).toBe(true)
		end)
	end)
end
