--!strict
local ServerScriptService = game:GetService("ServerScriptService")
local HackChallenge = require(ServerScriptService.Server.Core.HackChallenge)
return function(t: any)
	t.it("validates nonce, minimum latency, expiry and replay without exposing the answer", function()
		local challenge = HackChallenge.new("Sequence", 9, 10, 2, 1)
		t.expect(HackChallenge.public(challenge).answer).toBeNil()
		t.expect(select(2, HackChallenge.respond(challenge, 8, 2, 11))).toBe("StaleRequest")
		t.expect(select(2, HackChallenge.respond(challenge, 9, 2, 10.1))).toBe("TooEarly")
		t.expect((HackChallenge.respond(challenge, 9, 2, 11))).toBe(true)
		t.expect(select(2, HackChallenge.respond(challenge, 9, 2, 11.1))).toBe("StaleRequest")
		t.expect(select(2, HackChallenge.respond(HackChallenge.new("Cipher", 10, 0, 1, 1), 10, 1, 8)))
			.toBe("StaleRequest")
	end)
	t.it("uses server time for timing windows and consumes wrong answers", function()
		local early = HackChallenge.new("Timing", 1, 0, 1, 3)
		t.expect(select(2, HackChallenge.respond(early, 1, 1, 1))).toBe("ChallengeFailed")
		t.expect(early.used).toBe(true)
		local onTime = HackChallenge.new("Timing", 2, 0, 1, 3)
		t.expect((HackChallenge.respond(onTime, 2, 1, 2))).toBe(true)
		local late = HackChallenge.new("Timing", 3, 0, 1, 3)
		t.expect((HackChallenge.respond(late, 3, 1, 3))).toBe(false)
	end)
end
