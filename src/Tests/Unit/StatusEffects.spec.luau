--!strict
local ServerScriptService = game:GetService("ServerScriptService")
local StatusEffects = require(ServerScriptService.Server.Core.StatusEffects)

local BASE_SPEED, BASE_JUMP = 16, 50

return function(t: any)
	t.describe("StatusEffects", function()
		t.it("applies a 70% slow from the baseline, not the current speed", function()
			local s = StatusEffects.new()
			s:add({ key = "zone1", kind = "Slow", magnitude = 0.7, expiresAt = 10, source = "TimeFreeze" })
			local m = s:compute(BASE_SPEED, BASE_JUMP, 1)
			t.expect(m.walkSpeed).toBeNear(16 * 0.3, 1e-6)
			-- Re-applying the same key refreshes instead of compounding.
			s:add({ key = "zone1", kind = "Slow", magnitude = 0.7, expiresAt = 12, source = "TimeFreeze" })
			t.expect(s:compute(BASE_SPEED, BASE_JUMP, 1).walkSpeed).toBeNear(16 * 0.3, 1e-6)
		end)

		t.it("restores the exact baseline after expiry", function()
			local s = StatusEffects.new()
			s:add({ key = "zone1", kind = "Slow", magnitude = 0.7, expiresAt = 10, source = "TimeFreeze" })
			t.expect(s:prune(10)).toBe(true)
			local m = s:compute(BASE_SPEED, BASE_JUMP, 10)
			t.expect(m.walkSpeed).toBe(BASE_SPEED)
			t.expect(m.jumpPower).toBe(BASE_JUMP)
			t.expect(m.slowed).toBe(false)
		end)

		t.it("overlapping slows take the strongest and expire independently", function()
			local s = StatusEffects.new()
			s:add({ key = "zoneA", kind = "Slow", magnitude = 0.7, expiresAt = 5, source = "A" })
			s:add({ key = "trap", kind = "Slow", magnitude = 0.4, expiresAt = 8, source = "B" })
			t.expect(s:compute(BASE_SPEED, BASE_JUMP, 1).walkSpeed).toBeNear(16 * 0.3, 1e-6)
			s:prune(5)
			-- The weaker, still-active slow remains after the stronger one expires.
			t.expect(s:compute(BASE_SPEED, BASE_JUMP, 5).walkSpeed).toBeNear(16 * 0.6, 1e-6)
			s:prune(8)
			t.expect(s:compute(BASE_SPEED, BASE_JUMP, 8).walkSpeed).toBe(BASE_SPEED)
		end)

		t.it("combines slow and haste multiplicatively from the base", function()
			local s = StatusEffects.new()
			s:add({ key = "slow", kind = "Slow", magnitude = 0.5, expiresAt = 10, source = "x" })
			s:add({ key = "haste", kind = "Haste", magnitude = 0.6, expiresAt = 10, source = "y" })
			t.expect(s:compute(BASE_SPEED, BASE_JUMP, 1).walkSpeed).toBeNear(16 * 0.5 * 1.6, 1e-6)
		end)

		t.it("stun and root zero movement; immunity suppresses stun and slow but not root", function()
			local s = StatusEffects.new()
			s:add({ key = "stun", kind = "Stun", magnitude = 1, expiresAt = 2, source = "trap" })
			local m = s:compute(BASE_SPEED, BASE_JUMP, 1)
			t.expect(m.walkSpeed).toBe(0)
			t.expect(m.jumpPower).toBe(0)
			t.expect(m.stunned).toBe(true)
			s:add({ key = "immune", kind = "SlowImmunity", magnitude = 1, expiresAt = 3, source = "gadget" })
			s:add({ key = "slow", kind = "Slow", magnitude = 0.7, expiresAt = 6, source = "zone" })
			m = s:compute(BASE_SPEED, BASE_JUMP, 1)
			t.expect(m.walkSpeed).toBe(BASE_SPEED)
			t.expect(m.stunned).toBe(false)
			-- When immunity ends first, the longer slow resumes.
			s:prune(3)
			t.expect(s:compute(BASE_SPEED, BASE_JUMP, 3).walkSpeed).toBeNear(16 * 0.3, 1e-6)
			s:add({ key = "root", kind = "Root", magnitude = 1, expiresAt = 20, source = "release" })
			s:add({ key = "immune2", kind = "SlowImmunity", magnitude = 1, expiresAt = 20, source = "gadget" })
			m = s:compute(BASE_SPEED, BASE_JUMP, 4)
			t.expect(m.rooted).toBe(true)
			t.expect(m.walkSpeed).toBe(0)
		end)

		t.it("cleanse removes only the requested kinds", function()
			local s = StatusEffects.new()
			s:add({ key = "slow", kind = "Slow", magnitude = 0.7, expiresAt = 10, source = "zone" })
			s:add({ key = "stun", kind = "Stun", magnitude = 1, expiresAt = 10, source = "trap" })
			s:add({ key = "haste", kind = "Haste", magnitude = 0.5, expiresAt = 10, source = "dash" })
			t.expect(s:removeKinds({ "Slow", "Stun" })).toBe(2)
			t.expect(s:count()).toBe(1)
			t.expect(s:has("Haste", 1)).toBe(true)
		end)

		t.it("clamps hostile magnitudes and NaN", function()
			local s = StatusEffects.new()
			s:add({ key = "a", kind = "Slow", magnitude = 5, expiresAt = 10, source = "x" })
			t.expect(s:compute(BASE_SPEED, BASE_JUMP, 1).walkSpeed).toBeNear(16 * (1 - StatusEffects.MAX_SLOW), 1e-6)
			s:add({ key = "a", kind = "Slow", magnitude = 0 / 0, expiresAt = 10, source = "x" })
			t.expect(s:compute(BASE_SPEED, BASE_JUMP, 1).walkSpeed).toBe(BASE_SPEED)
		end)

		t.it("reports the next expiry and clears completely", function()
			local s = StatusEffects.new()
			s:add({ key = "a", kind = "Slow", magnitude = 0.2, expiresAt = 9, source = "x" })
			s:add({ key = "b", kind = "Haste", magnitude = 0.2, expiresAt = 4, source = "x" })
			t.expect(s:nextExpiry()).toBe(4)
			s:clear()
			t.expect(s:count()).toBe(0)
			t.expect(s:nextExpiry()).toBeNil()
		end)
	end)
end
