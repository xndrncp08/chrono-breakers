--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local Config = require(ReplicatedStorage.Shared.Config.AnomalyConfig)
local AnomalyModel = require(ServerScriptService.Server.Core.AnomalyModel)
return function(t: any)
	t.it("telegraphs all eight events, advances once, expires and clears without catching up storms", function()
		for index, kind in Config.Order do
			local calls = 0
			local model = AnomalyModel.new("match", { Vector3.zero, Vector3.new(20, 0, 0) }, 0, function(n)
				calls += 1
				return if calls == 1 then index else math.min(1, n)
			end)
			t.expect((model:tick(Config.FirstDelay - 0.1))).toBeNil()
			local event, state = model:tick(Config.FirstDelay)
			assert(event, "expected anomaly warning")
			t.expect(event.kind).toBe(kind)
			t.expect(state).toBe("Warning")
			t.expect(event.destination ~= event.position).toBe(true)
			t.expect(select(2, model:tick(event.activatesAt))).toBe("Active")
			t.expect((model:tick(event.activatesAt + 0.1))).toBeNil()
			t.expect(select(2, model:tick(event.endsAt + 100))).toBe("Ended")
			t.expect((model:tick(event.endsAt + 100.1))).toBeNil()
			model:clear()
			t.expect((model:tick(1e9))).toBeNil()
		end
	end)
	t.it("uses bounded spatial membership and validates portal eligibility", function()
		local model = AnomalyModel.new("m", { Vector3.zero, Vector3.one * 20 }, 0, function()
			return 1
		end)
		local event = model:tick(Config.FirstDelay)
		assert(event, "expected anomaly warning")
		t.expect(AnomalyModel.contains(event, Vector3.new(1, 3, 1))).toBe(true)
		t.expect(AnomalyModel.contains(event, Vector3.new(1, 30, 1))).toBe(false)
		t.expect(AnomalyModel.contains(event, Vector3.new(30, 3, 1))).toBe(false)
		t.expect(AnomalyModel.portalAllowed(true, true, false, 5, 4, 4)).toBe(true)
		t.expect(AnomalyModel.portalAllowed(true, true, false, 5, 5, 4)).toBe(false)
		t.expect(AnomalyModel.portalAllowed(true, true, true, 5, 0, 4)).toBe(false)
		t.expect(AnomalyModel.portalAllowed(false, true, false, 5, 0, 4)).toBe(false)
		t.expect(AnomalyModel.portalAllowed(true, false, false, 5, 0, 4)).toBe(false)
		t.expect(AnomalyModel.portalAllowed(true, true, false, 0 / 0, 0, 4)).toBe(false)
	end)
end
