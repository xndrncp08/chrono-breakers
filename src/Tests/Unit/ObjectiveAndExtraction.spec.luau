--!strict
local ServerScriptService = game:GetService("ServerScriptService")
local ExtractionModel = require(ServerScriptService.Server.Core.ExtractionModel)
local ObjectiveTracker = require(ServerScriptService.Server.Core.ObjectiveTracker)

return function(t: any)
	t.describe("ObjectiveTracker", function()
		t.it("deduplicates completions and fires the threshold exactly once", function()
			local o = ObjectiveTracker.new(3)
			for _, id in { "A", "B", "C", "D" } do
				o:register(id)
			end
			t.expect(select(2, o:markComplete("A"))).toBe(false)
			local accepted, reached = o:markComplete("A")
			t.expect(accepted).toBe(false)
			t.expect(reached).toBe(false)
			o:markComplete("B")
			local acceptedC, reachedC = o:markComplete("C")
			t.expect(acceptedC).toBe(true)
			t.expect(reachedC).toBe(true)
			local acceptedD, reachedD = o:markComplete("D")
			t.expect(acceptedD).toBe(true)
			t.expect(reachedD).toBe(false)
			t.expect(o:completedCount()).toBe(4)
		end)

		t.it("rejects unregistered objectives", function()
			local o = ObjectiveTracker.new(1)
			o:register("A")
			t.expect((o:markComplete("Forged"))).toBe(false)
			t.expect(o:completedCount()).toBe(0)
		end)

		t.it("requires a positive threshold", function()
			t.expect(function()
				ObjectiveTracker.new(0)
			end).toThrow()
		end)
	end)

	t.describe("ExtractionModel", function()
		t.it("cannot extract before activation", function()
			local e = ExtractionModel.new()
			t.expect(e:update(1, true, 0, 3)).toBe(false)
			t.expect(e:update(1, true, 10, 3)).toBe(false)
		end)

		t.it("activates once with a server deadline", function()
			local e = ExtractionModel.new()
			t.expect(e:activate(100, 60)).toBe(true)
			t.expect(e:activate(105, 60)).toBe(false)
			t.expect(e.endsAt).toBe(160)
			t.expect(e:isExpired(159)).toBe(false)
			t.expect(e:isExpired(160)).toBe(true)
		end)

		t.it("requires a continuous channel and extracts each player once", function()
			local e = ExtractionModel.new()
			e:activate(0, 60)
			t.expect(e:update(1, true, 1, 3)).toBe(false)
			t.expect(e:update(1, true, 2, 3)).toBe(false)
			t.expect(e:update(1, false, 2.5, 3)).toBe(false) -- left the zone: channel resets
			t.expect(e:update(1, true, 3, 3)).toBe(false)
			t.expect(e:channelProgress(1, 4.5, 3)).toBeNear(0.5, 1e-6)
			t.expect(e:update(1, true, 6, 3)).toBe(true)
			t.expect(e:update(1, true, 10, 3)).toBe(false)
			t.expect(e:extractedCount()).toBe(1)
			t.expect(e:hasExtracted(1)).toBe(true)
		end)

		t.it("rejects extraction after the window closes", function()
			local e = ExtractionModel.new()
			e:activate(0, 10)
			e:update(1, true, 9, 3)
			t.expect(e:update(1, true, 12, 3)).toBe(false)
			t.expect(e:extractedCount()).toBe(0)
		end)
	end)
end
