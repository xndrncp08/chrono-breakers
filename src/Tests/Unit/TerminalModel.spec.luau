--!strict
local ServerScriptService = game:GetService("ServerScriptService")
local TerminalModel = require(ServerScriptService.Server.Core.TerminalModel)

return function(t: any)
	t.describe("TerminalModel", function()
		t.it("starts Locked and rejects hacks until unlocked", function()
			local term = TerminalModel.new("T1", "Terminal")
			local ok, code = term:start(1, 0)
			t.expect(ok).toBe(false)
			t.expect(code).toBe("Locked")
			t.expect(term:unlock()).toBe(true)
			t.expect((term:start(1, 0))).toBe(true)
			t.expect(term.state).toBe("Hacking")
		end)

		t.it("progresses from server time and completes exactly once", function()
			local term = TerminalModel.new("T1", "Terminal")
			term:unlock()
			term:start(1, 0)
			t.expect(term:advance(5, 15)).toBe(false)
			t.expect(term.progress).toBeNear(1 / 3, 1e-6)
			t.expect(term:advance(15, 15)).toBe(true)
			t.expect(term.state).toBe("Completed")
			t.expect(term.completedBy).toBe(1)
			t.expect(term:advance(20, 15)).toBe(false)
		end)

		t.it("enforces one hacker at a time", function()
			local term = TerminalModel.new("T1", "Terminal")
			term:unlock()
			term:start(1, 0)
			local ok, code = term:start(2, 1)
			t.expect(ok).toBe(false)
			t.expect(code).toBe("Busy")
			local ok2, code2 = term:start(1, 1)
			t.expect(ok2).toBe(false)
			t.expect(code2).toBe("AlreadyHacking")
		end)

		t.it("retains progress on interruption and enforces the lockout", function()
			local term = TerminalModel.new("T1", "Terminal")
			term:unlock()
			term:start(1, 0)
			term:advance(6, 15)
			t.expect(term:interrupt("OutOfRange", 6, 1.5, true)).toBe(true)
			t.expect(term.state).toBe("Interrupted")
			t.expect(term.lastInterruptReason).toBe("OutOfRange")
			t.expect(term.hackerUserId).toBeNil()
			t.expect(term.progress).toBeNear(0.4, 1e-6)
			t.expect((term:start(2, 7))).toBe(false)
			t.expect(term:tickLockout(7)).toBe(false)
			t.expect(term:tickLockout(7.5)).toBe(true)
			t.expect((term:start(2, 8))).toBe(true)
			t.expect(term:advance(17, 15)).toBe(true)
			t.expect(term.completedBy).toBe(2)
		end)

		t.it("can reset progress on interruption when configured", function()
			local term = TerminalModel.new("T1", "Terminal")
			term:unlock()
			term:start(1, 0)
			term:advance(6, 15)
			term:interrupt("Damaged", 6, 0, false)
			t.expect(term.progress).toBe(0)
		end)

		t.it("does not count time spent not hacking", function()
			local term = TerminalModel.new("T1", "Terminal")
			term:unlock()
			term:start(1, 0)
			term:advance(3, 15)
			term:interrupt("Cancelled", 3, 0, true)
			term:tickLockout(100)
			term:start(1, 100)
			term:advance(103, 15)
			t.expect(term.progress).toBeNear(6 / 15, 1e-6)
		end)

		t.it("completed terminals cannot be locked, restarted, or reopened", function()
			local term = TerminalModel.new("T1", "Terminal")
			term:unlock()
			term:start(1, 0)
			term:advance(15, 15)
			t.expect(term:lock()).toBe(false)
			t.expect(term.state).toBe("Completed")
			local ok, code = term:start(2, 16)
			t.expect(ok).toBe(false)
			t.expect(code).toBe("AlreadyCompleted")
			t.expect(TerminalModel.isLegal("Completed", "Available")).toBe(false)
		end)

		t.it("locking mid-hack clears the hacker", function()
			local term = TerminalModel.new("T1", "Terminal")
			term:unlock()
			term:start(1, 0)
			t.expect(term:lock()).toBe(true)
			t.expect(term.state).toBe("Locked")
			t.expect(term.hackerUserId).toBeNil()
		end)

		t.it("throttles broadcast cadence", function()
			local term = TerminalModel.new("T1", "Terminal")
			t.expect(term:shouldBroadcast(0, 0.25)).toBe(true)
			t.expect(term:shouldBroadcast(0.1, 0.25)).toBe(false)
			t.expect(term:shouldBroadcast(0.3, 0.25)).toBe(true)
		end)
	end)
end
