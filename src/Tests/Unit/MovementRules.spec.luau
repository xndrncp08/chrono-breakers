--!strict
local ServerScriptService = game:GetService("ServerScriptService")
local Rules = require(ServerScriptService.Server.Core.MovementRules)
return function(t: any)
	t.it("accepts bounded latency and rejects teleports, bounds escapes and non-finite positions", function()
		local from = Vector3.new(0, 3, 0)
		local low, high = Vector3.new(-90, -5, -90), Vector3.new(90, 40, 90)
		t.expect(Rules.valid(from, Vector3.new(10, 3, 0), 0.5, 17, low, high, 1.6, 6)).toBe(true)
		t.expect(Rules.valid(from, Vector3.new(70, 3, 0), 0.5, 17, low, high, 1.6, 6)).toBe(false)
		t.expect(Rules.valid(from, Vector3.new(91, 3, 0), 10, 17, low, high, 1.6, 6)).toBe(false)
		t.expect(Rules.valid(from, Vector3.new(0, 100, 0), 0.5, 17, low, high, 1.6, 6)).toBe(false)
		t.expect(Rules.valid(from, Vector3.new(0 / 0, 3, 0), 0.5, 17, low, high, 1.6, 6)).toBe(false)
	end)
	t.it("allows server-authorized haste without compounding and rejects root bypasses", function()
		local low, high = Vector3.new(-90, -5, -90), Vector3.new(90, 40, 90)
		t.expect(Rules.valid(Vector3.zero, Vector3.new(24, 0, 0), 0.5, 49.5, low, high, 1.6, 6)).toBe(true)
		t.expect(Rules.valid(Vector3.zero, Vector3.new(10, 0, 0), 0.5, 0, low, high, 1.6, 6)).toBe(false)
	end)
end
