--!strict
local ServerScriptService = game:GetService("ServerScriptService")
local Harness = require(ServerScriptService.Tests.Helpers.DirectorHarness)
return function(t: any)
	t.it("supports two assistants at reduced efficiency and drops only invalid helpers", function()
		local h = Harness.new({ cooperativeHacking = true })
		h:startMatch({ 1, 2, 3, 4, 5 })
		local team = h:infiltrators()
		for _, userId in team do
			h.distance[userId] = { T1 = 5, T2 = 5 }
		end
		t.expect((h.director:requestHackStart(team[1], "T1", h.now))).toBe(true)
		t.expect((h.director:requestHackStart(team[2], "T1", h.now))).toBe(true)
		t.expect((h.director:requestHackStart(team[3], "T1", h.now))).toBe(true)
		t.expect(select(2, h.director:requestHackStart(team[4], "T1", h.now))).toBe("Busy")
		t.expect(select(2, h.director:requestHackStart(team[2], "T2", h.now))).toBe("AlreadyHacking")
		h:advance(2)
		-- 1 + 0.8 + 0.8 hackers over a 15 s terminal.
		t.expect((h.director:publicTerminal("T1") :: any).progress).toBeNear(2 * 2.6 / 15, 0.03)
		h.director:notifyDamage(team[2], h.now)
		t.expect(#(h.director:publicTerminal("T1") :: any).assistants).toBe(1)
		t.expect((h.director:publicTerminal("T1") :: any).state).toBe("Hacking")
		t.expect((h.director:requestHackStart(team[4], "T1", h.now))).toBe(true)
		h:advance(6)
		t.expect((h.director:publicTerminal("T1") :: any).state).toBe("Completed")
		t.expect((h.director:getParticipant(team[3]) :: any).assists).toBe(1)
		t.expect((h.director:getParticipant(team[4]) :: any).assists).toBe(1)
		t.expect((h.director:getParticipant(team[2]) :: any).assists).toBe(0)
	end)
	t.it(
		"issues calibration pulses to every hacker; Great adds progress, a timeout costs progress and traces",
		function()
			local h = Harness.new({ cooperativeHacking = true, interactiveChallenges = true, hackDuration = 60 })
			h:startMatch({ 1, 2, 3 })
			local a, b = h:infiltrators()[1], h:infiltrators()[2]
			h:placeAt(a, "T1")
			h:placeAt(b, "T1")
			h.director:requestHackStart(a, "T1", h.now)
			h.director:requestHackStart(b, "T1", h.now)
			h:advance(5.3)
			t.expect(h:count("CalibrationIssued")).toBe(2)
			local session = h.director.session :: any
			local check = session.challenges[a].check
			t.expect(select(2, h.director:respondChallenge(a, "old-match", "T1", check.nonce, h.now, h.now)))
				.toBe("StaleRequest")
			t.expect(select(2, h.director:respondChallenge(a, session.matchId, "T2", check.nonce, h.now, h.now)))
				.toBe("WrongRole")
			h:advance(check.opensAt - h.now + 0.01, 0.01)
			local before = session.terminals.T1.progress
			t.expect((h.director:respondChallenge(a, session.matchId, "T1", check.nonce, h.now, h.now))).toBe(true)
			t.expect(session.terminals.T1.progress).toBeNear(before + 0.025)
			t.expect(h:last("CalibrationResult").grade).toBe("Great")
			t.expect((h.director:getParticipant(a) :: any).greats).toBe(1)
			h:advance(2)
			t.expect(h:last("CalibrationResult").userId).toBe(b)
			t.expect(h:last("CalibrationResult").grade).toBe("Miss")
			t.expect(h:count("HackRisk")).toBe(1)
			t.expect(h:last("HackRisk").terminalId).toBe("T1")
			t.expect(session.terminals.T1.state).toBe("Hacking")
		end
	)
	t.it("clears assistants on primary disconnect and never counts stale progress at the deadline", function()
		local h = Harness.new({ cooperativeHacking = true, interactiveChallenges = true, matchDuration = 3 })
		h:startMatch({ 1, 2, 3, 4 })
		local a, b = h:infiltrators()[1], h:infiltrators()[2]
		h:placeAt(a, "T1")
		h:placeAt(b, "T1")
		h.director:requestHackStart(a, "T1", h.now)
		h.director:requestHackStart(b, "T1", h.now)
		h.director:playerRemoving(a, h.now)
		t.expect(#(h.director:publicTerminal("T1") :: any).assistants).toBe(0)
		h:advance(4)
		t.expect(h.director:getPhase()).toBe("Resolving")
		t.expect(h:count("TerminalCompleted")).toBe(0)
	end)
end
