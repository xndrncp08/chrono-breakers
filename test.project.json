{
	"name": "ChronoBreakersTests",
	"tree": {
		"$className": "DataModel",
		"ReplicatedStorage": {
			"Shared": {
				"$path": "src/Shared"
			}
		},
		"ServerScriptService": {
			"Server": {
				"$path": "src/Server"
			},
			"Tests": {
				"$path": "src/Tests",
				"$attributes": {
					"RunE2E": true
				}
			},
			"$properties": {
				"LoadStringEnabled": true
			}
		},
		"StarterPlayer": {
			"StarterPlayerScripts": {
				"Client": {
					"$path": "src/Client"
				},
				"E2EClient": {
					"$path": "src/TestClient"
				}
			},
			"StarterCharacterScripts": {
				"$path": "src/StarterCharacterScripts"
			}
		},
		"Workspace": {
			"$properties": {
				"StreamingEnabled": false
			}
		},
		"Players": {
			"$properties": {
				"CharacterAutoLoads": true,
				"RespawnTime": 3
			}
		}
	}
}
